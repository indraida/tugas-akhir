# ============================================================================
# KONFIGURASI DATABASE POSTGRESQL & APLIKASI
# ============================================================================

# Kredensial PostgreSQL
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mydb
POSTGRES_PORT=5432

# Port Dashboard Web Streamlit
WEB_PORT=8501

# Mode Sumber Data (postgres / excel)
DATA_SOURCE=postgres
ALLOW_EXCEL_FALLBACK=true

# Database Connection URL
# Gunakan 'db' sebagai host jika di dalam container Docker:
DATABASE_URL=postgresql://myuser:mysecretpassword@db:5432/mydb

# Gunakan 'localhost' jika menjalankan skrip python di terminal lokal komputer Anda:
# DATABASE_URL=postgresql://myuser:mysecretpassword@localhost:5432/mydb
